datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String      @id @default(uuid())
  name         String
  email        String      @unique
  passwordHash String
  role         String      // ADMIN, FACULTY, STUDENT
  phone        String?
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  studentProfile Student?
  facultyProfile Faculty?
  auditLogs      AuditLog[]
  notifications  Notification[]
}

model Department {
  id          String    @id @default(uuid())
  name        String
  code        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  courses     Course[]
  students    Student[]
  faculty     Faculty[]
  subjects    Subject[]
}

model Course {
  id            String     @id @default(uuid())
  name          String
  code          String     @unique
  departmentId  String
  durationYears Int        @default(4)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  department    Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  sections      Section[]
  students      Student[]
  subjects      Subject[]
}

model Section {
  id           String   @id @default(uuid())
  name         String
  courseId     String
  year         Int
  semester     Int
  academicYear String   // e.g. "2025-2026"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  course             Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  students           Student[]
  facultyAssignments FacultySubject[]
  attendanceSessions AttendanceSession[]
  timetables         Timetable[]
}

model Student {
  id            String   @id @default(uuid())
  userId        String   @unique
  studentId     String   @unique
  rollNumber    String   @unique
  name          String
  email         String   @unique
  phone         String?
  departmentId  String
  courseId      String
  sectionId     String
  year          Int
  semester      Int
  academicYear  String
  admissionYear Int
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  department        Department         @relation(fields: [departmentId], references: [id])
  course            Course             @relation(fields: [courseId], references: [id])
  section           Section            @relation(fields: [sectionId], references: [id])
  attendanceRecords AttendanceRecord[]
}

model Faculty {
  id           String   @id @default(uuid())
  userId       String   @unique
  employeeId   String   @unique
  name         String
  email        String   @unique
  phone        String?
  departmentId String
  designation  String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  department         Department          @relation(fields: [departmentId], references: [id])
  facultyAssignments FacultySubject[]
  attendanceSessions AttendanceSession[]
  timetables         Timetable[]
}

model Subject {
  id           String   @id @default(uuid())
  name         String
  code         String   @unique
  credits      Int      @default(3)
  semester     Int
  courseId     String
  departmentId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  course             Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  department         Department          @relation(fields: [departmentId], references: [id])
  facultyAssignments FacultySubject[]
  attendanceSessions AttendanceSession[]
  timetables         Timetable[]
}

model FacultySubject {
  id           String   @id @default(uuid())
  facultyId    String
  subjectId    String
  sectionId    String
  academicYear String
  createdAt    DateTime @default(now())

  faculty Faculty @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([facultyId, subjectId, sectionId, academicYear])
}

model AttendanceSession {
  id        String   @id @default(uuid())
  subjectId String
  sectionId String
  facultyId String
  date      String   // ISO YYYY-MM-DD format
  hour      Int      // e.g., 1, 2, 3, 4, 5, 6
  topic     String?
  status    String   @default("SUBMITTED") // DRAFT, SUBMITTED, CANCELLED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subject Subject @relation(fields: [subjectId], references: [id])
  section Section @relation(fields: [sectionId], references: [id])
  faculty Faculty @relation(fields: [facultyId], references: [id])

  records AttendanceRecord[]

  @@unique([subjectId, sectionId, date, hour])
}

model AttendanceRecord {
  id        String   @id @default(uuid())
  sessionId String
  studentId String
  status    String   // PRESENT, ABSENT, LATE, EXCUSED
  markedAt  DateTime @default(now())
  markedBy  String   // userId of faculty or admin
  remarks   String?

  session AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
}

model Timetable {
  id        String   @id @default(uuid())
  sectionId String
  subjectId String
  facultyId String
  dayOfWeek String   // Monday, Tuesday, Wednesday, Thursday, Friday, Saturday
  startTime String   // e.g. "09:00"
  endTime   String   // e.g. "10:00"
  roomNumber String?

  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  faculty Faculty @relation(fields: [facultyId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String   // e.g. ATTENDANCE_CREATED, ATTENDANCE_UPDATED, USER_CREATED
  entity    String   // e.g. AttendanceRecord, User, Student
  entityId  String
  oldValue  String?  // JSON string
  newValue  String?  // JSON string
  timestamp DateTime @default(now())
  ipAddress String?

  user User @relation(fields: [userId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String   @default("INFO") // INFO, WARNING, SUCCESS, DANGER
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}
